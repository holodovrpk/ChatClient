<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatClient"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <!-- Стиль для скругленных кнопок -->
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для поля ввода -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ListBox (чистый, без рамок) -->
        <Style x:Key="CleanListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Панель подключения -->
            <RowDefinition Height="*"/>
            <!-- История сообщений -->
            <RowDefinition Height="Auto"/>
            <!-- Панель отправки -->
        </Grid.RowDefinitions>

        <!-- 1. Панель подключения -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Имя -->
                <TextBlock Text="Имя:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="NameTextBox" Text="Вася" 
                         Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,15,0"/>

                <!-- Сервер -->
                <TextBlock Grid.Column="2" Text="Сервер:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="3" x:Name="ServerTextBox" Text="127.0.0.1" 
                         Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,15,0"/>

                <!-- Порт -->
                <TextBlock Grid.Column="4" Text="Порт:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="5" x:Name="PortTextBox" Text="5000" Width="60" 
                         Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,15,0"/>

                <!-- Кнопка Подключиться -->
                <Button Grid.Column="6" Content="🔌 Подключиться" 
                        Style="{StaticResource RoundButtonStyle}" 
                        Background="#007ACC" Height="32" Width="140" Margin="0,0,10,0"
                        Click="Connect_Click"/>

                <!-- Кнопка Отключить -->
                <Button Grid.Column="7" Content="⏏ Отключить" 
                        Style="{StaticResource RoundButtonStyle}" 
                        Background="#C0392B" Height="32" Width="120"
                        Click="Disconnect_Click"/>
            </Grid>
        </Border>

        <!-- 2. История сообщений -->
        <Border Grid.Row="1" Background="Gray" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <ListBox x:Name="ChatListBox" Foreground="White"
                     Style="{StaticResource CleanListBoxStyle}">
                
            </ListBox>
        </Border>

        <!-- 3. Панель отправки -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Поле ввода с плейсхолдером -->
            <TextBox x:Name="MessageTextBox" 
                     Height="40" 
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     Margin="0,0,15,0"
                     >

                <!-- Ресурс для плейсхолдера -->
                <TextBox.Resources>
                    <VisualBrush x:Key="PlaceholderBrush" AlignmentX="Left" Stretch="None">
                        <VisualBrush.Visual>
                            <TextBlock Text="Введите сообщение..." Foreground="#777777" 
                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </TextBox.Resources>

                <!-- Стиль (только здесь, БЕЗ атрибута Style в теге TextBox) -->
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Кнопка Отправить -->
            <Button Grid.Column="1" Content="✉ Отправить" 
                    Style="{StaticResource RoundButtonStyle}" 
                    Background="#007ACC" Height="40" Width="140"
                    Click="Send_Click"/>
        </Grid>
    </Grid>
</Window>
